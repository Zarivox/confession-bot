# Bot token (Developer Portal → Bot → Token)
BOT_TOKEN=your_token_here

# Application ID (Developer Portal → General Information → Application ID)
CLIENT_ID=your_client_id_here

# Your server's ID (right-click server → Copy Server ID)
GUILD_ID=your_guild_id_here

# ID of the channel where confessions will be posted
CONFESSION_CHANNEL_ID=your_channel_id_here

# Your Discord user ID — grants admin commands
ADMIN_ID=your_discord_user_id_here

# Bot language: en or fr (default: en)
LANG=en

# Max number of confessions kept in memory (oldest evicted when exceeded)
MAX_CONFESSIONS_MEMORY=1000

# Role ID assigned to users who sign the contract (optional but recommended)
# The bot will auto-fix channel permissions on startup if this is set
PARTICIPANT_ROLE_ID=your_role_id_here

# Allow participants to send regular messages in the confession channel (true/false)
ALLOW_CHANNEL_MESSAGES=false

# ─── Privacy at rest ────────────────────────────────────────────────────────
# AUTHOR_PUB   — X25519 public key (32 bytes base64). Used by the bot to
#                encrypt anonymous author IDs at rest in confessions-anon.json.
# VOTE_SECRET  — 32 bytes base64. HMAC key for anonymising voter IDs in the
#                JSON files. Lookup-only, never reverses.
AUTHOR_PUB=your_x25519_public_key_base64
VOTE_SECRET=your_vote_secret_base64

# To customise the contract text (or any other locale string) per instance,
# copy `locales/private.example.js` to `locales/private.js` and edit it.
# That file is gitignored and overrides the active locale at startup.
